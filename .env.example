# <NETWORK> (chainId: <CHAIN_ID>)
ETH_NODE_URI_<CHAIN_ID>=""

## Autopilot Agents
AUTOPILOT_ADMIN_API_KEYS="replace-with-strong-admin-key"
AUTOPILOT_VIEWER_API_KEYS="replace-with-strong-viewer-key"
