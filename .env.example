AUTOPILOT_MAX_DRAWDOWN_BPS="1500"
AUTOPILOT_TOTAL_CAPITAL_USD="8000"
AUTOPILOT_MAX_CAPITAL_PER_STRATEGY_USD="5000"
AUTOPILOT_ALLOWED_COMMAND_PREFIXES="yarn foundry:script"
AUTOPILOT_HOT_SIGNER_ENV="HOT_SIGNER_PRIVATE_KEY"
AUTOPILOT_COLD_SIGNER_ADDR_ENV="COLD_SIGNER_ADDRESS"
